{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public profile of a user",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "displayName": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["email", "displayName", "createdAt"]
    },
    "Event": {
      "title": "Event",
      "description": "Nightlife event",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 100 },
        "distance": { "type": "string", "maxLength": 20 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "maxLength": 50 },
        "price": { "type": "string", "maxLength": 20 },
        "tags": { "type": "array", "items": { "type": "string", "maxLength": 20 } }
      },
      "required": ["title", "location", "distance", "imageUrl", "date", "price", "tags"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "A purchased ticket",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "purchasedAt": { "type": "timestamp" }
      },
      "required": ["eventId", "userId", "purchasedAt"]
    },
    "Like": {
      "title": "Like",
      "description": "User favorited an event",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "likedAt": { "type": "timestamp" }
      },
      "required": ["eventId", "userId", "likedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Available events"
    },
    "tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/Ticket" },
      "description": "Purchased tickets"
    },
    "likes/{likeId}": {
      "schema": { "$ref": "#/entities/Like" },
      "description": "Event likes"
    }
  }
}
